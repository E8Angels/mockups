        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute[name.name='sortDir'] > Literal[value!=/^(?:asc|desc)$/]",
        "message": "<DataTable> sortDir must be one of 'asc' | 'desc'."
