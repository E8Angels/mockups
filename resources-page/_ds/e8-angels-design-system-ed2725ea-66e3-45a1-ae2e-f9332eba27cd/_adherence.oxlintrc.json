        "selector": "JSXOpeningElement[name.name='ConfirmationRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|href|key|ref|className|style|children)$/]",
        "message": "<ConfirmationRow> doesn't accept that prop. Declared props: label, value, href."
      },
      {
