{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/Avatar/**",
              "components/core/AvatarStack/**",
              "components/core/Badge/**",
              "components/core/Button/**",
              "components/core/Card/**",
              "components/core/Divider/**",
              "components/core/Eyebrow/**",
              "components/core/IconButton/**",
              "components/core/Tag/**",
              "components/data/CountChip/**",
              "components/data/DataTable/**",
              "components/data/EmptyState/**",
              "components/data/GroupHeader/**",
              "components/data/RatingCell/**",
              "components/data/RatingMatrix/**",
              "components/data/SegmentedRating/**",
              "components/data/Skeleton/**",
              "components/data/StatTile/**",
              "components/forms/Field/**",
              "components/forms/Input/**",
              "components/forms/SearchInput/**",
              "components/forms/SelectControl/**",
              "components/forms/StageTabs/**",
              "components/forms/Toggle/**",
              "components/forms/UnderlineTabs/**",
              "components/media/Icon/**",
              "components/media/Wordmark/**",
              "components/portal/ActivityRail/**",
              "components/portal/ChatFab/**",
              "components/portal/CompanyCard/**",
              "components/portal/ConfirmationSummary/**",
              "components/portal/CtaBanner/**",
              "components/portal/DetailSheet/**",
              "components/portal/EventItem/**",
              "components/portal/MemberRow/**",
              "components/portal/NewsRow/**",
              "components/portal/SectionCard/**",
              "components/portal/SectionHeader/**",
              "components/portal/SlackStrip/**",
              "components/portal/TopNav/**",
              "ui_kits/portal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Urbanist|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Urbanist, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:chips|label|onCollapse|key|ref|className|style|children)$/]",
        "message": "<ActivityRail> doesn't accept that prop. Declared props: chips, label, onCollapse."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|initials|size|shape|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, initials, size, shape."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|tile)$/]",
        "message": "<Avatar> shape must be one of 'circle' | 'tile'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvatarStack'] > JSXAttribute > JSXIdentifier[name!=/^(?:people|size|max|overlap|key|ref|className|style|children)$/]",
        "message": "<AvatarStack> doesn't accept that prop. Declared props: people, size, max, overlap."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|mono|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, mono, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|teal|neutral|stage|amber|danger|dark)$/]",
        "message": "<Badge> tone must be one of 'ok' | 'teal' | 'neutral' | 'stage' | 'amber' | 'danger' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|pill|disabled|iconLeft|iconRight|as|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, pill, disabled, iconLeft, iconRight, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:filled|outline|quiet|link)$/]",
        "message": "<Button> variant must be one of 'filled' | 'outline' | 'quiet' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|pad|as|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, pad, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:card|inset|sheet|ok)$/]",
        "message": "<Card> variant must be one of 'card' | 'inset' | 'sheet' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompanyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|logo|initials|description|programme|team|key|ref|className|style|children)$/]",
        "message": "<CompanyCard> doesn't accept that prop. Declared props: name, logo, initials, description, programme, team."
      },
